# ---- Voice provider -------------------------------------------------------
# Pocket TTS voice-cloning weights are gated. Accept the terms at
# https://huggingface.co/kyutai/pocket-tts and create a read token at
# https://huggingface.co/settings/tokens
HF_TOKEN=
DEFAULT_PROVIDER=pocket_tts
ENABLED_PROVIDERS=pocket_tts
# Limit torch CPU threads (0 = default)
POCKET_TTS_THREADS=0

# ---- Security -------------------------------------------------------------
# Required in production. In development they're generated into data/secrets.json.
# ENCRYPTION_KEY must be a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENVIRONMENT=development
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database -------------------------------------------------------------
# Default: SQLite in backend/data. PostgreSQL: pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://voice:voice@localhost:5432/voice_studio

# ---- Storage --------------------------------------------------------------
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./data/storage
# S3-compatible (AWS S3, MinIO, R2...). Requires: pip install boto3
# STORAGE_BACKEND=s3
# S3_BUCKET=voice-studio
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_SAMPLE_SECONDS=300
MAX_SCRIPT_CHARS=100000
RATE_LIMIT_PER_MINUTE=600
GENERATION_RATE_LIMIT_PER_HOUR=60
